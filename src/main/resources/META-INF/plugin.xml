<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>git.more.profiles.git-profiles</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Git Profiles</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/a-krasilnikov/Git-Profiles">Aleksandr K</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Manage git identity profiles (<code>user.name</code> + <code>user.email</code>).
        Store profiles once, then apply any of them as the global git identity or assign one
        per git repository in every project.<br>
        Works in remote development / split mode: the UI runs in the frontend (JetBrains Client)
        while git operations run on the backend (host), communicating over RPC.
        ]]></description>

    <!-- Base platform requirement. Git4Idea is required per content module (see the backend module
         descriptor), not plugin-wide, so the frontend can load without it on the thin client. -->
    <depends>com.intellij.modules.platform</depends>

    <!-- 2025.3 (build 253) is the first release with Split Mode, content modules and the RPC
         framework this plugin is built on; it cannot load on anything older. -->
    <idea-version since-build="253"/>

    <!-- Split into content modules. `shared` loads on both sides; `frontend` and `backend` load
         only where their platform dependencies (intellij.platform.frontend / .backend) resolve. -->
    <content>
        <module name="git-profiles.shared" loading="required"/>
        <module name="git-profiles.frontend"/>
        <module name="git-profiles.backend"/>
    </content>
</idea-plugin>
